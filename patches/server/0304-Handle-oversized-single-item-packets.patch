 public class ClientboundSetEquipmentPacket implements Packet<ClientGamePacketListener> {
     private static final byte CONTINUE_MASK = -128;
+    private static final org.slf4j.Logger LOGGER = LogUtils.getLogger(); // Purpur
     private final int entity;
     private final List<Pair<EquipmentSlot, ItemStack>> slots;
 
@@ -32,6 +35,31 @@ public class ClientboundSetEquipmentPacket implements Packet<ClientGamePacketLis
         } while ((i & -128) != 0);
     }
 
+    // Purpur start - handle oversized single item packets
+    @Override
+    public boolean hasLargePacketFallback() {
+        return true;
+    }
+
+    @Override
+    public boolean packetTooLarge(Connection connection) {
+        List<Pair<EquipmentSlot, ItemStack>> replacements = Lists.newArrayListWithCapacity(this.slots.size());
+        for (Pair<EquipmentSlot, ItemStack> pair : this.slots) {
+            ItemStack itemStack = pair.getSecond();
+            replacements.add(Pair.of(
+                pair.getFirst(),
+                new ItemStack(itemStack.getItem(), itemStack.getCount())
+            ));
+        }
+        LOGGER.warn(
+            "Not sending oversized equipment item metadata for entity {}. The server-side items were not modified.",
+            this.entity
+        );
+        connection.send(new ClientboundSetEquipmentPacket(this.entity, replacements));
+        return true;
+    }
+    // Purpur end - handle oversized single item packets
+
     @Override
     public void write(FriendlyByteBuf buf) {
         buf.writeVarInt(this.entity);
