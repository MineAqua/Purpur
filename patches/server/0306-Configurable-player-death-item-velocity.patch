From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: J4im3x0 <36940599+J4im3x0@users.noreply.github.com>
Date: Thu, 30 Jul 2026 21:27:03 -0400
Subject: [PATCH] Configurable player death item velocity


diff --git a/src/main/java/net/minecraft/server/level/ServerPlayer.java b/src/main/java/net/minecraft/server/level/ServerPlayer.java
index 305b90d10a499e9731f5178433fb10207e428091..32c1e50f6619c26836dec6efb6304606d5f300d6 100644
--- a/src/main/java/net/minecraft/server/level/ServerPlayer.java
+++ b/src/main/java/net/minecraft/server/level/ServerPlayer.java
@@ -969,7 +969,20 @@ public class ServerPlayer extends Player {
         if (!keepInventory) {
             for (ItemStack item : this.getInventory().getContents()) {
                 if (!item.isEmpty() && !EnchantmentHelper.hasVanishingCurse(item)) {
-                    loot.add(new DefaultDrop(item, stack -> this.drop(stack, true, false, false))); // Paper - Restore vanilla drops behavior; drop function taken from Inventory#dropAll (don't fire drop event)
+                    // Purpur start - configurable death item velocity
+                    loot.add(new DefaultDrop(item, stack -> {
+                        ItemEntity droppedItem = this.drop(stack, true, false, false); // Paper - Restore vanilla drops behavior; drop function taken from Inventory#dropAll (don't fire drop event)
+                        if (droppedItem != null) {
+                            Vec3 velocity = droppedItem.getDeltaMovement();
+                            double horizontalScale = this.level().purpurConfig.playerDeathItemVelocityHorizontal / 0.5D;
+                            droppedItem.setDeltaMovement(
+                                    velocity.x * horizontalScale,
+                                    this.level().purpurConfig.playerDeathItemVelocityVertical,
+                                    velocity.z * horizontalScale
+                            );
+                        }
+                    }));
+                    // Purpur end - configurable death item velocity
                 }
             }
         }
diff --git a/src/main/java/org/purpurmc/purpur/PurpurWorldConfig.java b/src/main/java/org/purpurmc/purpur/PurpurWorldConfig.java
index 7dc82ffccc157a17335f1bc56ab81be3813294f6..0525fbbe54fe3e4b43b6bf94b0bc83f5c5d064f5 100644
--- a/src/main/java/org/purpurmc/purpur/PurpurWorldConfig.java
+++ b/src/main/java/org/purpurmc/purpur/PurpurWorldConfig.java
@@ -425,6 +425,8 @@ public class PurpurWorldConfig {
     public boolean idleTimeoutTargetPlayer = true;
     public String playerDeathExpDropEquation = "expLevel * 7";
     public int playerDeathExpDropMax = 100;
+    public double playerDeathItemVelocityHorizontal = 0.5D;
+    public double playerDeathItemVelocityVertical = 0.2D;
     public boolean teleportIfOutsideBorder = false;
     public boolean teleportOnNetherCeilingDamage = false;
     public boolean totemOfUndyingWorksInInventory = false;
@@ -453,6 +455,16 @@ public class PurpurWorldConfig {
         idleTimeoutTargetPlayer = getBoolean("gameplay-mechanics.player.idle-timeout.mobs-target", idleTimeoutTargetPlayer);
         playerDeathExpDropEquation = getString("gameplay-mechanics.player.exp-dropped-on-death.equation", playerDeathExpDropEquation);
         playerDeathExpDropMax = getInt("gameplay-mechanics.player.exp-dropped-on-death.maximum", playerDeathExpDropMax);
+        playerDeathItemVelocityHorizontal = getDouble("gameplay-mechanics.player.death-item-velocity.horizontal", playerDeathItemVelocityHorizontal);
+        playerDeathItemVelocityVertical = getDouble("gameplay-mechanics.player.death-item-velocity.vertical", playerDeathItemVelocityVertical);
+        if (!Double.isFinite(playerDeathItemVelocityHorizontal) || playerDeathItemVelocityHorizontal < 0.0D) {
+            log(Level.WARNING, "Invalid player death item horizontal velocity for world '" + worldName + "'. Using 0.5.");
+            playerDeathItemVelocityHorizontal = 0.5D;
+        }
+        if (!Double.isFinite(playerDeathItemVelocityVertical) || playerDeathItemVelocityVertical < 0.0D) {
+            log(Level.WARNING, "Invalid player death item vertical velocity for world '" + worldName + "'. Using 0.2.");
+            playerDeathItemVelocityVertical = 0.2D;
+        }
         teleportIfOutsideBorder = getBoolean("gameplay-mechanics.player.teleport-if-outside-border", teleportIfOutsideBorder);
         teleportOnNetherCeilingDamage = getBoolean("gameplay-mechanics.player.teleport-on-nether-ceiling-damage", teleportOnNetherCeilingDamage);
         totemOfUndyingWorksInInventory = getBoolean("gameplay-mechanics.player.totem-of-undying-works-in-inventory", totemOfUndyingWorksInInventory);
